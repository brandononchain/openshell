{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenShell",
  "version": "0.1.0",
  "identifier": "io.openclaw.openshell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenShell Mission Control",
        "width": 1400,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/openclaw/openshell/releases/latest/download/latest.json",
        "https://github.com/openclaw/openshell/releases/download/nightly/latest.json"
      ],
      "dialog": true,
      "pubkey": "UPDATE_PUBLIC_KEY_PLACEHOLDER"
    }
  }
}
